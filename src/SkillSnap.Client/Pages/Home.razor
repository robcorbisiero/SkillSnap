@page "/"
@using SkillSnap.Contracts
@using SkillSnap.Client.Services
@inject LearningSessionService Sessions
@inject AccountSession Account

<PageTitle>Learning sessions | SkillSnap</PageTitle>
<section class="intro">
    <p class="eyebrow">A little time. A new skill.</p>
    <h1>Your next learning<br />moment starts here.</h1>
    <p>Explore practical sessions in web development. Find a topic, meet an instructor, and make room to grow.</p>
</section>
<section aria-labelledby="sessions-heading">
    <div class="section-heading">
        <div><p class="eyebrow">Explore the programme</p><h2 id="sessions-heading">Learning sessions</h2></div>
        <button class="refresh" @onclick="LoadAsync" disabled="@(loading || pendingSession is not null)">Refresh sessions</button>
    </div>
    <p class="demo-note">Demo programme · Fictional instructors and sample dates · Sign in to manage your registrations across devices</p>
    @if (!Account.IsSignedIn)
    {
        <p class="booking-notice"><a href="/account">Sign in or create an account</a> to register. Existing browser bookings can be imported from your account page.</p>
    }
    <div class="filters" aria-label="Session filters">
        <button class="refresh" aria-pressed="@((!mySessionsOnly).ToString().ToLowerInvariant())" @onclick="() => mySessionsOnly = false">All sessions</button>
        <button class="refresh" disabled="@(!Account.IsSignedIn)" aria-pressed="@(mySessionsOnly.ToString().ToLowerInvariant())" @onclick="() => mySessionsOnly = true">My sessions (@sessions.Count(s => s.IsRegistered))</button>
    </div>
    @if (notice is not null)
    {
        <p class="booking-notice" role="status">@notice</p>
    }
    @if (actionError is not null)
    {
        <p class="booking-notice error" role="alert">@actionError</p>
    }
    <div aria-live="polite" aria-busy="@loading.ToString().ToLowerInvariant()">
    @if (loading)
    {
        <p class="state" role="status">Loading learning sessions…</p>
    }
    else if (error is not null)
    {
        <div class="state error" role="alert"><h3>We couldn’t load the sessions.</h3><p>@error</p><button @onclick="LoadAsync">Try again</button></div>
    }
    else if (!VisibleSessions.Any())
    {
        <p class="state">@(mySessionsOnly ? "You haven’t registered for any sessions yet. Explore All sessions to find one." : "No sessions have been scheduled yet. Check back soon.")</p>
    }
    else
    {
        <p class="count">@VisibleSessions.Count() @(VisibleSessions.Count() == 1 ? "session" : "sessions") · Times shown in UTC</p>
        <div class="session-grid">
        @foreach (var session in VisibleSessions)
        {
            <article class="session-card" @key="session.Id">
                <span class="topic">@session.Topic</span>
                <h3>@session.Title</h3>
                <p class="description">@session.Description</p>
                <p class="instructor">With @session.Instructor</p>
                <dl>
                    <div><dt>When</dt><dd><time datetime="@session.StartsAtUtc.ToString("O")">@session.StartsAtUtc.ToString("MMM d, yyyy · HH:mm") UTC</time></dd></div>
                    <div><dt>Duration</dt><dd>@session.DurationMinutes minutes</dd></div>
                    <div><dt>Availability</dt><dd>@session.SeatsRemaining of @session.Capacity seats available</dd></div>
                </dl>
                @if (!Account.IsSignedIn)
                {
                    <a class="signin-booking" href="/account">Sign in to register</a>
                }
                else if (session.IsRegistered)
                {
                    <p class="registered">✓ You’re registered</p>
                    <p class="attendance-status">Attendance: @(session.AttendanceStatus is null or AttendanceStatus.NotRecorded ? "Not recorded" : session.AttendanceStatus.ToString())</p>
                    <button class="refresh booking-button" disabled="@(pendingSession is not null || session.AttendanceStatus is AttendanceStatus.Attended or AttendanceStatus.Absent)"
                        aria-label="@($"Cancel registration for {session.Title}")" @onclick="() => UpdateRegistrationAsync(session, false)">
                        @(pendingSession == session.Id ? "Updating…" : "Cancel registration")
                    </button>
                    @if (session.AttendanceStatus is AttendanceStatus.Attended or AttendanceStatus.Absent)
                    {
                        <p class="demo-note">Ask an organizer to clear attendance before cancelling.</p>
                    }
                }
                else
                {
                    <button class="booking-button" disabled="@(pendingSession is not null || session.SeatsRemaining == 0 || session.StartsAtUtc <= DateTime.UtcNow)"
                        aria-label="@($"Register for {session.Title}")" @onclick="() => UpdateRegistrationAsync(session, true)">
                        @(pendingSession == session.Id ? "Updating…" : session.StartsAtUtc <= DateTime.UtcNow ? "Session started" : session.SeatsRemaining == 0 ? "Session full" : "Register for session")
                    </button>
                }
            </article>
        }
        </div>
    }
    </div>
</section>

@code {
    private List<LearningSessionDto> sessions = [];
    private bool loading = true;
    private string? error;
    private bool mySessionsOnly;
    private int? pendingSession;
    private string? notice;
    private string? actionError;
    private IEnumerable<LearningSessionDto> VisibleSessions => mySessionsOnly ? sessions.Where(s => s.IsRegistered) : sessions;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        notice = null;
        actionError = null;
        try
        {
            await Account.RefreshAsync();
            if (!Account.IsSignedIn) mySessionsOnly = false;
            sessions = await Sessions.GetSessionsAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        {
            error = "Check that the SkillSnap API is running, then try again.";
        }
        finally { loading = false; }
    }

    private async Task UpdateRegistrationAsync(LearningSessionDto session, bool register)
    {
        if (pendingSession is not null) return;
        pendingSession = session.Id;
        notice = null;
        actionError = null;
        var saved = false;
        try
        {
            await Sessions.SetRegistrationAsync(session.Id, register);
            saved = true;
            sessions = await Sessions.GetSessionsAsync();
            notice = register ? $"You’re registered for {session.Title}." : $"Registration cancelled for {session.Title}.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException or JSException)
        {
            actionError = saved
                ? "Your change was saved, but we couldn’t refresh the list. Refresh sessions to see your updated registration."
                : ex is HttpRequestException { StatusCode: not null } ? ex.Message
                : "We couldn’t confirm your change. Check the API, then refresh sessions before trying again.";
        }
        finally { pendingSession = null; }
    }
}
