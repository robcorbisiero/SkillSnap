FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet publish src/SkillSnap.Client -c Release -o /out/client \
    && dotnet publish src/SkillSnap.Api -c Release -o /out/api \
    && mkdir -p /out/api/wwwroot \
    && cp -a /out/client/wwwroot/. /out/api/wwwroot/ \
    && printf '{"ApiBaseUrl":""}\n' > /out/api/wwwroot/appsettings.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out/api .
ENV ASPNETCORE_HTTP_PORTS=8080 PORT=8080 ASPNETCORE_ENVIRONMENT=Production
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "SkillSnap.Api.dll"]
